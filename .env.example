# Copy to .env.local (gitignored). Values are bundled into the app, so never put secrets here.
# iOS simulator: http://localhost:8080/api/v1 · Android emulator: http://10.0.2.2:8080/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_DEV_LOGIN_ID=dev-user
# Real Kakao/Google login: leave EXPO_PUBLIC_DEV_LOGIN_ID empty to open the real SDKs
# (the dev-user value above uses the bootTestRun fake login). Kakao native app key and
# Google iOS/Web OAuth client ids are public values; the web client id is what the server verifies.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
